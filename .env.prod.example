# Template for docker-compose.prod.yml. Copy to .env.prod and fill in.
#
#   cp .env.prod.example .env.prod
#
# .env.prod is gitignored. When Jenkins deploys it supplies these from its own
# credential store instead, so the file is only needed for manual runs.

# Port the app is served on. http://<host>:<APP_PORT>
# Deliberately not 8080 - Jenkins defaults to that and would collide.
APP_PORT=8090

# --- Database ---
DB_NAME=portiq_db
DB_USERNAME=portiq
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Secrets ---
# These three are mandatory under the prod profile: the app refuses to start on the
# development defaults rather than come up quietly insecure. See StartupSecurityValidator.
#
# Generate with:  openssl rand -base64 48
JWT_SECRET=
# Generate with:  openssl rand -base64 32
# Keep this stable once you have real data - rotating it makes every encrypted
# column unreadable.
DB_ENCRYPTION_KEY=

# --- Seeded login ---
# Must be at least 12 characters and must not be the ChangeMe123! default.
OWNER_USERNAME=owner
OWNER_PASSWORD=

# --- WebAuthn / biometric login ---
# Origin-bound. WEBAUTHN_ORIGIN must exactly match the URL in the address bar,
# and WebAuthn needs a secure context: http://localhost works, a plain-HTTP LAN
# address does not.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Portiq
WEBAUTHN_ORIGIN=http://localhost:8090

# --- Optional: summary + statement image import ---
# Leave blank to disable; both features report "not configured" rather than fail.
INSIGHTS_API_KEY=
INSIGHTS_API_URL=
INSIGHTS_MODEL=
INSIGHTS_VISION_MODEL=

# --- Optional: analytics tuning ---
ANALYTICS_BENCHMARK=^NSEI
ANALYTICS_RISK_FREE_RATE=6.5

# --- Security ---
# Browser origins allowed to call the API. Comma-separated, explicit - '*' is rejected
# at startup. Set this to wherever the frontend is actually served from.
CORS_ALLOWED_ORIGINS=http://localhost:8090

# Hosts the server may make outbound requests to. Anything else is refused before the
# connection opens, so a hostile ticker cannot steer a fetch at an internal service.
OUTBOUND_ALLOWED_HOSTS=query1.finance.yahoo.com,query2.finance.yahoo.com,feeds.finance.yahoo.com,news.google.com

# Failed-login lockout. Five wrong passwords for one account, or twenty from one address,
# and that caller waits out the window.
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_LOCKOUT_MINUTES=15

# Only true when a reverse proxy in front overwrites X-Forwarded-For. If the app is
# directly exposed, leave it false or a caller can forge a new identity per request and
# slip every per-IP limit.
TRUST_PROXY=true

# Swagger UI and the OpenAPI document. false means they need a session.
DOCS_PUBLIC=false

# TLS to the database. Set DISABLED only while the database has no certificate configured,
# and treat that as temporary - the connection carries credentials and decrypted holdings.
DB_SSL_MODE=REQUIRED

# Session token lifetime. Logout revokes server-side, so this is the ceiling on a token
# that was captured and never logged out.
JWT_EXPIRY_HOURS=12
