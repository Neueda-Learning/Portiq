# Template for docker-compose.prod.yml. Copy to .env.prod and fill in.
#
#   cp .env.prod.example .env.prod
#
# .env.prod is gitignored. When Jenkins deploys it supplies these from its own
# credential store instead, so the file is only needed for manual runs.

# Port the app is served on. http://<host>:<APP_PORT>
# Deliberately not 8080 - Jenkins defaults to that and would collide.
APP_PORT=8090

# --- Database ---
DB_NAME=portiq_db
DB_USERNAME=portiq
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Secrets ---
# Generate with:  openssl rand -base64 48
JWT_SECRET=
# Generate with:  openssl rand -base64 32
# Keep this stable once you have real data - rotating it makes every encrypted
# column unreadable.
DB_ENCRYPTION_KEY=

# --- Seeded login ---
OWNER_USERNAME=owner
OWNER_PASSWORD=

# --- WebAuthn / biometric login ---
# Origin-bound. WEBAUTHN_ORIGIN must exactly match the URL in the address bar,
# and WebAuthn needs a secure context: http://localhost works, a plain-HTTP LAN
# address does not.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Portiq
WEBAUTHN_ORIGIN=http://localhost:8090

# --- Optional: summary + statement image import ---
# Leave blank to disable; both features report "not configured" rather than fail.
INSIGHTS_API_KEY=
INSIGHTS_API_URL=
INSIGHTS_MODEL=
INSIGHTS_VISION_MODEL=

# --- Optional: analytics tuning ---
ANALYTICS_BENCHMARK=^NSEI
ANALYTICS_RISK_FREE_RATE=6.5
