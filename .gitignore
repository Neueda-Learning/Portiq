# Environment files (contain secrets)
.env
.env.*
!.env.example
!.env.prod.example
backend/.env
frontend/.env

# Backend
backend/target/
backend/backend-run.log

# Locally generated development JWT key. Only ever created when JWT_SECRET is unset;
# it keeps dev sessions alive across restarts and must never reach the repository.
backend/.dev-secrets/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/frontend-run.log
frontend/npm-install.log

# Broker statements / personal account data
*.xlsx

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Logs. The directory is tracked via logs/.gitkeep; the logs themselves are not.
# How to read them is documented in docs/LOGGING.md.
/logs/*
!/logs/.gitkeep

# A log directory anywhere else is one the app created from a different working directory
# (running from backend/ resolves the relative LOG_DIR against backend/). Never committable.
logs/
*.log
