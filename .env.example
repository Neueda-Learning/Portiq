# Used by docker-compose.yml to configure the local MySQL container.
# Copy this file to .env and adjust as needed: cp .env.example .env

DB_NAME=portiq_db
DB_USERNAME=portiq
DB_PASSWORD=portiq
DB_ROOT_PASSWORD=portiq_root

# --- Optional: AI features -------------------------------------------------
# Portfolio summaries, Excel/smart file import and statement screenshot import.
# Everything else in the app works without these.
#
# Only the key is required — the URL already defaults to Groq's OpenAI-compatible
# endpoint. Get a free key at https://console.groq.com/keys
#
# NOTE: this file configures docker compose. For a local `mvn spring-boot:run`, put the
# same variables in backend/.env instead - that one is read by the application itself.
INSIGHTS_API_KEY=
# INSIGHTS_API_URL=https://api.groq.com/openai/v1/chat/completions
# INSIGHTS_MODEL=llama-3.3-70b-versatile
# INSIGHTS_VISION_MODEL=qwen/qwen3.6-27b
